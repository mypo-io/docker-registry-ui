# Docker Registry URL (with protocol, no trailing slash)
VITE_REGISTRY_URL=https://registry.mypo.clouds

# Docker Registry credentials (used by nginx to proxy requests to the registry)
REGISTRY_USERNAME=your_registry_username
REGISTRY_PASSWORD=your_registry_password

# Site access credentials (Basic Auth popup in the browser)
SITE_USERNAME=admin
SITE_PASSWORD=your_site_password
